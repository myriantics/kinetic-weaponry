{
  "schemaVersion": 1,
  "id": "kinetic-weaponry",
  "version": "${version}",
  "name": "Kinetic Weaponry",
  "description": "Small equipment mod that give Heavy Cores more uses! Created for ModFest 1.21!",
  "authors": [
    "Myriantics"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/kinetic-weaponry/",
    "sources": "https://github.com/myriantics/kinetic-weaponry/"
  },
  "license": "MIT",
  "icon": "assets/kinetic_weaponry/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.myriantics.kinetic_weaponry.KWCommon"
    ],
    "client": [
      "net.myriantics.kinetic_weaponry.KWClient"
    ]
  },
  "mixins": [
    "kinetic_weaponry.mixins.json",
    {
      "config": "kinetic_weaponry.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.17.3",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": ">=0.116.7"
